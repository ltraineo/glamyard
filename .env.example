# Display name. Change this when the real name is picked.
APP_NAME="Who's Going"

# Required in production. Any long random string.
SESSION_SECRET=

# Postgres connection string. If unset, a local file database (.data) is used,
# which is only suitable for development.
DATABASE_URL=

# LinkedIn sign-in. When LINKEDIN_CLIENT_ID is set, LinkedIn replaces the
# placeholder email sign-in everywhere.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Public base URL, e.g. https://example.com. Used for the LinkedIn redirect
# and invite links. Optional locally.
APP_URL=

# Optional. Max invites per member (admins are exempt). Unset means no cap.
INVITE_CAP=
